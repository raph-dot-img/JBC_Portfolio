# Copier ce fichier en .env puis le remplir : cp .env.example .env
# Le .env n'est jamais versionné (voir .gitignore).

# --- Serveur FRP (frps) ---
# Adresse publique (IP ou nom de domaine) du serveur qui fait tourner frps
FRP_SERVER_ADDRESS=frp.exemple.fr
# Port de connexion de frps (« bindPort » côté serveur)
FRP_SERVER_BIND_PORT=7000
# Port ouvert sur le serveur distant, vers lequel Nginx Reverse Proxy redirige caignec.eu
FRP_SERVER_REMOTE_PORT=45888
# Jeton partagé avec frps (« auth.token » côté serveur)
FRP_AUTH_TOKEN=change-moi

# --- Formulaire de contact ---
# Adresse du formulaire Formspree (https://formspree.io/f/<identifiant>)
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
